Host pi01-ssh.ldavincif.com
    HostName pi01-ssh.ldavincif.com
    User davincif

Host pi02-ssh.ldavincif.com
    HostName pi02-ssh.ldavincif.com
    User davincif

Host pi04-ssh.ldavincif.com
    HostName pi04-ssh.ldavincif.com
    User davincif
    # for backup only!
    # IdentityFile ~/.ssh/yubikey/homelab_ssh/id_ed25519_sk_backup
    # IdentityAgent none
    # IdentitiesOnly yes
    # or use:
    # SSH_AUTH_SOCK="" ssh -i ~/.ssh/yubikey/homelab_ssh/id_ed25519_sk_backup davincif@pi04-ssh.ldavincif.com

Host pi03-ssh.ldavincif.com
    HostName pi03-ssh.ldavincif.com
    User davincif

Host *-ssh.ldavincif.com
    ProxyCommand cloudflared access ssh --hostname %h

Host gitea-ssh.ldavincif.com
    HostName gitea-ssh.ldavincif.com
    User ldavincif
    IdentityFile ~/.ssh/yubikey/homelab_services/ed25519-sk
    IdentitiesOnly yes
