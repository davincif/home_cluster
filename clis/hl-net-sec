main() {
  if [[ $# -lt 1 ]]; then
    show_help
    exit 1
  fi

  local cmd="$1"; shift

  case "$cmd" in
    i|install)
      setup_pi_homelab "$@"
      ;;
    status)
      check_status "$@"
      ;;
    -h|--help|help)
      show_help
      ;;
    *)
      echo "[ERROR] Unknown command: $cmd" >&2
      show_help
      exit 1
      ;;
  esac
}

main "$@"
