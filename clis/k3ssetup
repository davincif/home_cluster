#!/usr/bin/env bash
set -euo pipefail

# ==========================
# Host prep
# ==========================

turnoff_swap() {
  echo "[INFO] Disabling swap..."
  sudo swapoff -a || true
  # Comment out fstab swap entries (best-effort)
  sudo sed -i.bak '/\s\+swap\s\+/ s/^/#/' /etc/fstab || true
}

# ==========================
# Raspberry Pi detection
# ==========================

# Returns 0 if running on a Raspberry Pi, 1 otherwise.
is_raspberry_pi() {
  local model=""

  # Best signal: device-tree model
  for f in /proc/device-tree/model /sys/firmware/devicetree/base/model; do
    if [[ -r "$f" ]]; then
      model="$(tr -d '\0' <"$f" 2>/dev/null || true)"
      if [[ "$model" == *"Raspberry Pi"* ]]; then
        return 0
      fi
    fi
  done

  # Fallback: device-tree compatible strings
  for f in /proc/device-tree/compatible /sys/firmware/devicetree/base/compatible; do
    if [[ -r "$f" ]]; then
      if tr -d '\0' <"$f" 2>/dev/null | grep -qiE 'raspberrypi|brcm,bcm27|brcm,bcm271'; then
        return 0
      fi
    fi
  done

  # Last resort: cpuinfo hints (less reliable, but helps)
  if [[ -r /proc/cpuinfo ]]; then
    if grep -qiE 'Raspberry Pi|BCM27|BCM271' /proc/cpuinfo; then
      return 0
    fi
  fi

  return 1
}

detect_is_raspberry() {
  if is_raspberry_pi; then
    echo true
  else
    echo false
  fi
}

# --------------------------
# Raspberry Pi OS specifics
# --------------------------

# Ensure iptables tools exist on host.
ensure_iptables_tools() {
  local missing=false

  for bin in iptables-save iptables-restore ip6tables-save ip6tables-restore; do
    if ! command -v "$bin" >/dev/null 2>&1; then
      missing=true
      break
    fi
  done

  if [[ "$missing" == true ]]; then
    echo "[INFO] Installing iptables tools (required by k3s)..."
    sudo apt-get update -y
    sudo apt-get install -y iptables
  else
    echo "[INFO] iptables tools already present."
  fi
}

# Pick the correct cmdline.txt path for Raspberry Pi OS.
get_rpi_cmdline_path() {
  local candidates=(
    "/boot/firmware/cmdline.txt"
    "/boot/cmdline.txt"
  )

  for p in "${candidates[@]}"; do
    if [[ -f "$p" ]]; then
      echo "$p"
      return 0
    fi
  done

  return 1
}

# Ensure required cgroup parameters exist in Raspberry Pi cmdline.
# Note: cmdline.txt must remain a single line.
ensure_rpi_cgroup_params() {
  local cmdline_path
  cmdline_path="$(get_rpi_cmdline_path)" || {
    echo "[ERROR] Could not find Raspberry Pi cmdline.txt under /boot." >&2
    return 1
  }

  local required_params=(
    "cgroup_memory=1"
    "cgroup_enable=memory"
    "cgroup_enable=cpuset"
  )

  local current
  current="$(sudo cat "$cmdline_path")"

  local updated="$current"
  local changed=false

  for param in "${required_params[@]}"; do
    if ! grep -qw -- "$param" <<<"$current"; then
      updated+=" $param"
      changed=true
    fi
  done

  if [[ "$changed" == true ]]; then
    echo "[INFO] Updating $cmdline_path to enable required cgroups..."
    sudo sh -c "printf '%s\n' '$updated' > '$cmdline_path'"
    echo "[WARN] Kernel cmdline changed. Reboot is required before starting k3s."
    return 2
  fi

  echo "[INFO] Required cgroup parameters already present in $cmdline_path."
  return 0
}

# Prepare Raspberry Pi OS host requirements for k3s.
prepare_raspberry_pi_host() {
  ensure_iptables_tools

  ensure_rpi_cgroup_params
  local rc=$?

  if [[ $rc -eq 2 ]]; then
    echo "[INFO] Please reboot now: sudo reboot"
    echo "[INFO] After reboot, re-run: ./k3ssetup install"
    exit 0
  elif [[ $rc -ne 0 ]]; then
    return 1
  fi
}

# ==========================
# k3s setup functions
# ==========================

install_k3s() {
  local is_raspberry="$1"

  turnoff_swap

  if [[ "$is_raspberry" == true ]]; then
    echo "[INFO] Raspberry Pi detected/enabled. Applying Raspberry prerequisites..."
    prepare_raspberry_pi_host
  fi

  echo "[INFO] Installing k3s..."
  curl -sfL https://get.k3s.io | sh -
  echo "[INFO] k3s installation complete."
}

test_k3s() {
  echo "[INFO] Testing k3s installation..."

  if ! command -v k3s >/dev/null 2>&1; then
    echo "[ERROR] k3s command not found. Installation may have failed." >&2
    exit 1
  fi

  k3s --version
  sudo k3s kubectl version --client --output=yaml || true
  sudo k3s kubectl get nodes -o wide || true

  echo "[INFO] k3s basic checks completed."
}

clean_k3s_resources() {
  echo "[INFO] Cleaning Kubernetes resources in the current namespace (default)..."
  sudo kubectl delete all --all || true
  sudo kubectl delete configmap --all || true
  sudo kubectl delete secret --all || true
  echo "[INFO] Resources cleaned (namespace-scoped)."
}

remove_k3s() {
  echo "[INFO] Removing k3s installation..."
  sudo /usr/local/bin/k3s-uninstall.sh || true
  sudo /usr/local/bin/k3s-agent-uninstall.sh || true
  echo "[INFO] k3s has been fully removed."
}

# ==========================
# CLI dispatcher
# ==========================

show_help() {
  cat <<'EOF'
Usage: ./k3ssetup <command> [options]

Commands:
  install [--raspberry]      Install and test k3s.
  clean --all               Delete Kubernetes resources (pods, configmaps, secrets) in current namespace.
  remove-k3s                Remove k3s and all its components from the system.

Notes:
  - Raspberry Pi is auto-detected (no flag needed).
  - --raspberry forces Raspberry prerequisites.

Options:
  --raspberry               Apply Raspberry Pi OS prerequisites (iptables tools + cgroup cmdline flags).
EOF
}

handle_install() {
  local is_raspberry
  is_raspberry="$(detect_is_raspberry)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --raspberry)
        is_raspberry=true
        shift
        ;;
      *)
        echo "[ERROR] Unknown option for install: $1" >&2
        show_help
        exit 1
        ;;
    esac
  done

  install_k3s "$is_raspberry"
  test_k3s
}

handle_clean() {
  local clean_all=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        clean_all=true
        shift
        ;;
      *)
        echo "[ERROR] Unknown option: $1" >&2
        show_help
        exit 1
        ;;
    esac
  done

  if [[ "$clean_all" == true ]]; then
    clean_k3s_resources
  else
    echo "[ERROR] You must specify --all to clean resources." >&2
    exit 1
  fi
}

handle_remove_k3s() {
  remove_k3s
}

main() {
  if [[ $# -lt 1 ]]; then
    show_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    install)
      handle_install "$@"
      ;;
    clean)
      handle_clean "$@"
      ;;
    remove-k3s)
      handle_remove_k3s "$@"
      ;;
    *)
      echo "[ERROR] Unknown command: $cmd" >&2
      show_help
      exit 1
      ;;
  esac
}

main "$@"
