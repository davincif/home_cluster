# The password DB seafile's user
SEAFILE_DB_PASSWD=ThePasswordOfTheSeafileDBUser

# The password of the root DB user
SEAFILE_DB_ROOT_PASSWD=ThePasswordOfTheDBRootUser

# Seafile system administrator's password
SEAFILE_ADMIN_PASSWORD=ThePasswordOfTheSeafileAdmin

# Just generate a new one: openssl rand -hex 32
SEAFILE_JWT_PRIVATE_KEY=TOKEN